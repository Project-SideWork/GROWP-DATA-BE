APP_NAME=analysis-pipeline
APP_ENV=local
LOG_LEVEL=INFO
BACKEND_BASE_URL=http://localhost:8080
BACKEND_RESULT_PATH=/api/v1/analysis-results
BACKEND_RANKING_RESULTS_PATH=/api/v1/analytics/results
BACKEND_PROJECT_APPLICANTS_PATH=/api/v1/analytics/projects/{id}/evaluation-dataset
BACKEND_CLUB_APPLICANTS_PATH=/api/v1/analytics/clubs/{id}/evaluation-dataset
BACKEND_STUDY_APPLICANTS_PATH=/api/v1/analytics/studies/{id}/evaluation-dataset
BACKEND_API_KEY=
REQUEST_TIMEOUT_SECONDS=10
DELIVERY_MAX_ATTEMPTS=3
BACKEND_FETCH_CONCURRENCY=5
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=growp-analysis-pipeline
KAFKA_CONSUMER_GROUP_ID=growp-analysis-consumer
